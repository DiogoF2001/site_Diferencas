msgid "Email address"
msgstr "Endereço de e-mail"

msgid "Wrong email address or password."
msgstr "E-mail ou palavra-passe incorretos."

msgid "Too many failed attempts. Please try again in a few minutes."
msgstr "Demasiadas tentativas falhadas. Tente de novo daqui a alguns minutos."

msgid ""
"This account has no access to the portal at the moment. Please contact your "
"location's secretariat."
msgstr ""
"Esta conta não tem acesso ao portal neste momento. Contacte o secretariado "
"do seu polo."

msgid ""
"This account must set up two-factor authentication before signing in. Ask "
"your location's secretariat for a new link."
msgstr ""
"Esta conta precisa de ativar a autenticação de dois fatores antes de entrar. "
"Peça um novo link ao secretariado do seu polo."

msgid "Full name"
msgstr "Nome completo"

msgid "Only for a new account. An existing account keeps its name."
msgstr "Só para uma conta nova. Uma conta que já existe mantém o nome."

msgid "Role"
msgstr "Papel"

msgid "Subrole"
msgstr "Subpapel"

msgid "Only for professionals."
msgstr "Só para profissionais."

msgid "Start date"
msgstr "Data de início"

msgid "End date"
msgstr "Data de fim"

msgid "The last day with access. Required for interns."
msgstr "O último dia com acesso. Obrigatória para estagiárias."

msgid "A new account needs a name."
msgstr "Uma conta nova precisa de um nome."

msgid "Code"
msgstr "Código"

msgid "The code has 6 digits."
msgstr "O código tem 6 algarismos."

msgid "Creates the admin account from the environment. Safe to run repeatedly."
msgstr ""
"Cria a conta de admin a partir das variáveis de ambiente. Pode ser corrido "
"várias vezes."

msgid "PORTAL_ADMIN_EMAIL and PORTAL_ADMIN_PASSWORD must be set."
msgstr "É preciso definir PORTAL_ADMIN_EMAIL e PORTAL_ADMIN_PASSWORD."

msgid "Another admin account already exists."
msgstr "Já existe outra conta de admin."

msgid "Admin account created."
msgstr "Conta de admin criada."

msgid "This email address belongs to an account that is not the admin."
msgstr "Este endereço de e-mail pertence a uma conta que não é a de admin."

msgid "The admin account already exists; nothing to create."
msgstr "A conta de admin já existe; não há nada a criar."

msgid ""
"Removes the two-factor devices of an account, for when the admin loses "
"theirs."
msgstr ""
"Remove os dispositivos de autenticação de dois fatores de uma conta, para "
"quando o admin perde o seu."

msgid "There is no account with this email address."
msgstr "Não há nenhuma conta com este endereço de e-mail."

msgid "Two-factor authentication reset. Set it up again at next sign-in."
msgstr ""
"Autenticação de dois fatores reposta. Configure-a de novo na próxima entrada."

msgid "email address"
msgstr "endereço de e-mail"

msgid "full name"
msgstr "nome completo"

msgid "active"
msgstr "ativo"

msgid "date joined"
msgstr "data de criação"

msgid "user"
msgstr "utilizador"

msgid "users"
msgstr "utilizadores"

msgid "The email address must be in lowercase."
msgstr "O endereço de e-mail tem de estar em minúsculas."

