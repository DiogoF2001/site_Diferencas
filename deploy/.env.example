# Copiar para deploy/.env e substituir todos os valores. Nunca fazer commit do .env.

# Domínio público do portal e e-mail para os certificados
PORTAL_DOMAIN=portal.example.test
ACME_EMAIL=tecnico@example.test

# Django. Gerar a chave com: openssl rand -hex 50
DJANGO_SECRET_KEY=substituir-por-um-valor-gerado
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=portal.example.test
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.test
DJANGO_HSTS_SECONDS=31536000

# PostgreSQL: superutilizador, usado só na inicialização da base de dados
POSTGRES_DB=portal
POSTGRES_USER=portal_superuser
POSTGRES_PASSWORD=substituir-por-um-valor-gerado

# PostgreSQL: dono das tabelas, usado só nas migrações. Não é superutilizador
PORTAL_OWNER_USER=portal_owner
PORTAL_OWNER_PASSWORD=substituir-por-outro-valor-gerado

# PostgreSQL: utilizador da app e do worker, sem posse de tabelas
PORTAL_DB_USER=portal_app
PORTAL_DB_PASSWORD=substituir-por-outro-valor-gerado

# PostgreSQL: utilizador dos backups, só de leitura
PORTAL_BACKUP_USER=portal_backup
PORTAL_BACKUP_PASSWORD=substituir-por-outro-valor-gerado

# Conta de admin, criada uma vez com o serviço create-admin. Depois disso, a palavra-passe
# daqui já não é usada e pode ser apagada deste ficheiro.
PORTAL_ADMIN_EMAIL=admin@example.test
PORTAL_ADMIN_PASSWORD=substituir-por-outro-valor-gerado
PORTAL_ADMIN_NAME=Admin

# E-mail (convites e links de recuperação). Qualquer servidor SMTP, de preferência o do
# alojamento de e-mail do centro. Com a porta 465, usar EMAIL_USE_TLS=0 e EMAIL_USE_SSL=1.
EMAIL_HOST=smtp.example.test
EMAIL_PORT=587
EMAIL_HOST_USER=portal@example.test
EMAIL_HOST_PASSWORD=substituir-pela-palavra-passe-do-smtp
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL="Portal Diferenças <portal@example.test>"

# Contas: duração máxima da sessão, em horas, e o "Esqueci-me da palavra-passe" público
# (desligado: por agora, só o secretariado e a coordenação enviam links de recuperação).
# Dias, a contar do início de um papel com 2FA obrigatório, em que quem já entrou antes ainda
# entra só com a palavra-passe, apenas para configurar o 2FA.
PORTAL_SESSION_HOURS=8
PORTAL_SELF_PASSWORD_RESET=0
PORTAL_TWO_FACTOR_GRACE_DAYS=7

# Processos
GUNICORN_WORKERS=3
WORKER_INTERVAL_SECONDS=30

# Backups. Gerar as chaves com: age-keygen. Aqui fica só a chave pública;
# a chave privada guarda-se fora do servidor.
BACKUP_AGE_RECIPIENT=age1substituirpelachavepublica
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=30
# Pasta dos backups no servidor e o seu dono (id -u e id -g)
BACKUP_DIR=./backups
BACKUP_UID=1000
BACKUP_GID=1000
